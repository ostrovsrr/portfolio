---
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import Tags from '../components/Tags.astro';
import { featured, earlier } from '../data/projects';

const count = (n: number) => String(n).padStart(2, '0');
---
<Base
  title="Projects · Rodion Ostrovskii"
  description="Projects by Rodion Ostrovskii: a Shopify migration QA platform, a full-stack rewards platform, an AR game, and earlier work."
  active="projects"
>
  <main>
    <section class="section page-head">
      <p class="label">(work)</p>
      <h1 class="page-title">Projects</h1>
    </section>

    <section class="section">
      <p class="label">(selected work) <b>{count(featured.length)}</b></p>
      <div class="work">
        {featured.map((p, i) => <ProjectRow project={p} index={i} withCover />)}
      </div>
    </section>

    <section class="section">
      <p class="label">(earlier) <b>{count(earlier.length)}</b></p>
      <h2 class="earlier__title">Earlier practice projects</h2>
      <ul class="earlier">
        {earlier.map((p) => (
          <li>
            <a class="card" href={p.href} {...(p.external ? { target: '_blank', rel: 'noreferrer' } : {})}>
              {p.cover.kind === 'image' && <img src={p.cover.src} alt="" class="card__img" loading="lazy" width="370" height="278">}
              <h3 class="card__title">{p.title}</h3>
              <p class="card__desc">{p.description}</p>
              <Tags tags={p.tags} />
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Base>
