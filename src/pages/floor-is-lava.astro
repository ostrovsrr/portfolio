---
import Base from '../layouts/Base.astro';
---
<Base
  title="Floor is Lava AR · Rodion Ostrovskii"
  description="Case study: Floor is Lava, a mobile augmented reality game built in Unity with AR Foundation. Sheridan College capstone."
  active="projects"
>
  <main class="section">
    <div class="container">
      <div class="project-details">
        <h1 class="title-1">Floor is Lava: AR Game</h1>
  
        <!-- Swap for a gameplay GIF or screenshot when you have one -->
        <div class="project-details__cover" aria-hidden="true">
          <div class="cover-art cover-art--warm"><b>Floor is Lava</b><span>Unity · AR Foundation</span></div>
        </div>
  
        <div class="project-details__desc">
          <p>Skills: Unity, AR Foundation, C#, Firebase, Docker, Git</p>
        </div>
  
        <!-- Add later: a gameplay video button, plus "My role" and "Team" facts below -->
        <dl class="facts" style="grid-template-columns: repeat(2, 1fr); max-width: 560px;">
          <div class="fact"><dt>Timeline</dt><dd>Jan – Dec 2025</dd></div>
          <div class="fact"><dt>Context</dt><dd>Sheridan College capstone</dd></div>
        </dl>
  
        <div class="case">
          <h2 class="title-2">The idea</h2>
          <p>Take the childhood game and make it real: the phone's camera finds the floor, and the game covers it in lava. The room becomes the level.</p>
          <!-- Add later: a "What I built" section naming the parts you built yourself -->
  
          <p class="next-link"><a href="/qa-platform">Next project: Migration QA Platform →</a></p>
        </div>
      </div>
    </div>
  </main>
</Base>
