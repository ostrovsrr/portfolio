---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Tags from '../components/Tags.astro';

// Entries live in src/content/events/*.md. Newest first.
const events = (await getCollection('events')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const entries = await Promise.all(
  events.map(async (event) => ({ event, Content: (await render(event)).Content })),
);
const monthYear = new Intl.DateTimeFormat('en-CA', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base
  title="Events · Rodion Ostrovskii"
  description="Hackathons, competitions and community events Rodion Ostrovskii has taken part in."
  active="events"
>
  <main>
    <section class="section page-head">
      <p class="label">(events)</p>
      <h1 class="page-title">Events</h1>
    </section>

    <section class="section">
      <p class="label">(timeline) <b>{String(entries.length).padStart(2, '0')}</b></p>
      {entries.length === 0 && <p class="empty">Nothing here yet.</p>}
      <ol class="jobs events">
        {entries.map(({ event, Content }) => (
          <li class="job event">
            <time class="job__dates" datetime={event.data.date.toISOString().slice(0, 10)}>
              {monthYear.format(event.data.date)}
            </time>
            <div>
              <h2 class="job__title event__title">
                {event.data.link
                  ? <a href={event.data.link} target="_blank" rel="noreferrer">{event.data.title}</a>
                  : event.data.title}
              </h2>
              <p class="job__org">{event.data.role}</p>
            </div>
            <div class="job__summary">
              <Content />
              {event.data.tags.length > 0 && <Tags tags={event.data.tags} />}
            </div>
          </li>
        ))}
      </ol>
    </section>
  </main>
</Base>
