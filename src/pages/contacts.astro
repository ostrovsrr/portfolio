---
import Base from '../layouts/Base.astro';
---
<Base
  title="Contacts · Rodion Ostrovskii"
  description="Contact Rodion Ostrovskii, Shopify Solutions Engineer in Oakville, Ontario."
  active="contacts"
  footer="minimal"
>
  <main>
    <section class="section page-head">
      <p class="label">(contact)</p>
      <h1 class="page-title">Contacts</h1>
    </section>

    <section class="section">
      <p class="label">(details)</p>
      <ul class="contact-list">
        <li class="contact-list__item">
          <h2>Location</h2>
          <p>Oakville, Ontario</p>
        </li>
        <li class="contact-list__item">
          <h2>Email</h2>
          <p><a href="mailto:ostrovsrr@gmail.com">ostrovsrr@gmail.com</a></p>
        </li>
        <li class="contact-list__item">
          <h2>LinkedIn</h2>
          <p><a href="https://www.linkedin.com/in/rodion-ostrovskii/" target="_blank" rel="noreferrer">linkedin.com/in/rodion-ostrovskii</a></p>
        </li>
        <li class="contact-list__item">
          <h2>GitHub</h2>
          <p><a href="https://github.com/ostrovsrr" target="_blank" rel="noreferrer">github.com/ostrovsrr</a></p>
        </li>
        <!-- Add public/resume.pdf, then add a Resume item linking to /resume.pdf -->
      </ul>
    </section>
  </main>
</Base>
