---
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { featured } from '../data/projects';
import { experience, skills } from '../data/profile';
---
<Base
  title="Rodion Ostrovskii · Shopify Solutions Engineer"
  description="Rodion Ostrovskii, Shopify Solutions Engineer in Oakville, Ontario. Hydrogen and Liquid storefronts, plus the internal tooling that makes Shopify data migrations safe."
  ogDescription="Headless and Liquid storefronts, plus Shopify data migration tooling."
  active="home"
  overlayHeader
  footer="big"
>
  <div class="hero" id="hero">
    <img id="hero-img" src="/img/rodion-letters.webp" alt="Rodion" width="2000" height="664" fetchpriority="high">
  </div>

  <main>
    <section class="section" id="about">
      <p class="label">(about)</p>
      <h1 class="about__lede">Software Engineer with a focus on Shopify Development</h1>
      <p class="about__text">
        Full Stack Development | Data Migration | Shopify Storefront Development | API Integration
      </p>
      <div class="about__links">
        <a class="pill pill--dark" href="#work">See my projects ↓</a>
        <a class="pill" href="/resume.pdf" target="_blank" rel="noreferrer">See Resume</a>
      </div>
      <ul class="about__facts">
        <li><b>20+</b><span>merchant storefronts</span></li>
        <li><b>100+</b><span>data migrations</span></li>
        <li><b>3</b><span>co-op internships</span></li>
        <li><b>10+</b><span>hackathons and events</span></li>
      </ul>
    </section>

    <section class="section" id="work">
      <p class="label">(selected projects) <b>{String(featured.length).padStart(2, '0')}</b></p>
      <div class="work">
        {featured.map((p, i) => <ProjectRow project={p} index={i} />)}
        <a class="work__all pill" href="/projects">All projects →</a>
      </div>
    </section>

    <section class="section" id="experience">
      <p class="label">(experience)</p>
      <ol class="jobs">
        {experience.map((job) => (
          <li class="job">
            <span class="job__dates">{job.dates}</span>
            <div><h3 class="job__title">{job.title}</h3><p class="job__org">{job.org}</p></div>
            <p class="job__summary">{job.summary}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="section" id="skills">
      <p class="label">(skills)</p>
      <div class="skills">
        {skills.map((group) => <div><h3>{group.name}</h3><p>{group.items}</p></div>)}
      </div>
    </section>
  </main>

  <script is:inline>
  /*
   * Tile-displacement lettering. Applies to the "Rodion"
   * lettering only; the header and everything else on the page is plain static HTML.
   *
   * The lettering image is drawn to a canvas split into square tiles. Moving the pointer
   * pushes the tiles it passes over: each shows its slice of the image offset in the
   * direction of travel, scaled by pointer speed. Every push decays each frame, so the path
   * leaves a short fading trail, and when the pointer stops the lettering settles back to
   * the untouched image. The loop only runs while some tile is still displaced.
   *
   * On touch screens a finger dragging across the lettering does the same, without ever
   * blocking the page from scrolling (the listeners are passive), and a short automatic
   * sweep plays once on load so visitors know the lettering is interactive.
   * prefers-reduced-motion keeps the plain <img> everywhere.
   */
  (() => {
    const hero = document.getElementById('hero');
    const img = document.getElementById('hero-img');
    if (!hero || !img) return;

    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = matchMedia('(hover: hover) and (pointer: fine)');
    if (reduceMotion.matches) return;

    // ---- tuning ----
    const COLS = 44;            // tiles across the image on wide screens
    const COLS_NARROW = 24;     // fewer, bigger tiles on phones so the effect stays visible
    const INTRO_MS = 1100;      // touch screens: length of the one-off sweep on load
    const RADIUS = 2.6;         // brush radius, in tiles
    const PUSH = 2.2;           // how far a tile shifts relative to pointer travel
    const MAX_SHIFT = 2.4;      // cap, in tiles
    const DECAY = 0.9;          // per frame (60fps): ~0.7s from full push to settled
    const EPS = 0.02;           // below this (source px) a tile counts as settled

    const canvas = document.createElement('canvas');
    canvas.setAttribute('aria-hidden', 'true');
    const ctx = canvas.getContext('2d', { alpha: false });

    let tile = 0, cols = 0, rows = 0;
    let dx, dy;
    let scale = 1;
    let running = false;
    let last = null;

    function setup() {
      const rect = hero.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(rect.width * dpr);
      canvas.height = Math.round(rect.height * dpr);
      scale = canvas.width / img.naturalWidth;
      cols = rect.width < 700 ? COLS_NARROW : COLS;
      tile = img.naturalWidth / cols;
      rows = Math.ceil(img.naturalHeight / tile);
      dx = new Float32Array(cols * rows);
      dy = new Float32Array(cols * rows);
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';
      drawBase();
    }

    function drawBase() {
      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
    }

    // Works for mouse/pen events and for Touch objects (both have clientX/clientY)
    function toSource(e) {
      const r = canvas.getBoundingClientRect();
      return {
        x: (e.clientX - r.left) / r.width * img.naturalWidth,
        y: (e.clientY - r.top) / r.height * img.naturalHeight,
      };
    }

    function push(from, to) {
      const vx = to.x - from.x, vy = to.y - from.y;
      const dist = Math.hypot(vx, vy);
      if (dist < 0.5) return;
      const steps = Math.max(1, Math.ceil(dist / (tile * 0.5)));
      const cap = MAX_SHIFT * tile;
      for (let s = 1; s <= steps; s++) {
        const px = from.x + vx * s / steps, py = from.y + vy * s / steps;
        const cx = px / tile, cy = py / tile;
        const x0 = Math.max(0, Math.floor(cx - RADIUS)), x1 = Math.min(cols - 1, Math.ceil(cx + RADIUS));
        const y0 = Math.max(0, Math.floor(cy - RADIUS)), y1 = Math.min(rows - 1, Math.ceil(cy + RADIUS));
        for (let ty = y0; ty <= y1; ty++) {
          for (let tx = x0; tx <= x1; tx++) {
            const d = Math.hypot(tx + 0.5 - cx, ty + 0.5 - cy);
            if (d > RADIUS) continue;
            const f = (1 - d / RADIUS) ** 2 * PUSH / steps;
            const i = ty * cols + tx;
            dx[i] = Math.max(-cap, Math.min(cap, dx[i] + vx * f));
            dy[i] = Math.max(-cap, Math.min(cap, dy[i] + vy * f));
          }
        }
      }
      start();
    }

    function frame() {
      drawBase();
      let active = false;
      const size = tile * scale;
      for (let ty = 0; ty < rows; ty++) {
        for (let tx = 0; tx < cols; tx++) {
          const i = ty * cols + tx;
          const ox = dx[i], oy = dy[i];
          if (Math.abs(ox) < EPS && Math.abs(oy) < EPS) { dx[i] = dy[i] = 0; continue; }
          active = true;
          let sx = tx * tile - ox, sy = ty * tile - oy;
          sx = Math.max(0, Math.min(img.naturalWidth - tile, sx));
          sy = Math.max(0, Math.min(img.naturalHeight - tile, sy));
          const X = Math.round(tx * size), Y = Math.round(ty * size);
          const W = Math.round((tx + 1) * size) - X, H = Math.round((ty + 1) * size) - Y;
          ctx.drawImage(img, sx, sy, tile, tile, X, Y, W, H);
          dx[i] = ox * DECAY;
          dy[i] = oy * DECAY;
        }
      }
      if (active) requestAnimationFrame(frame);
      else { running = false; drawBase(); }
    }

    function start() {
      if (running) return;
      running = true;
      requestAnimationFrame(frame);
    }

    function init() {
      setup();
      hero.prepend(canvas);
      hero.classList.add('fx-on');
      hero.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse' && e.pointerType !== 'pen') return;
        const p = toSource(e);
        if (last) push(last, p);
        last = p;
      });
      hero.addEventListener('pointerleave', () => { last = null; });

      // Finger trail. Passive listeners: the page keeps scrolling as normal.
      let touchLast = null;
      let touched = false;
      hero.addEventListener('touchstart', (e) => {
        touched = true;
        touchLast = e.touches.length === 1 ? toSource(e.touches[0]) : null;
      }, { passive: true });
      hero.addEventListener('touchmove', (e) => {
        if (e.touches.length !== 1 || !touchLast) return;
        const p = toSource(e.touches[0]);
        push(touchLast, p);
        touchLast = p;
      }, { passive: true });
      const endTouch = () => { touchLast = null; };
      hero.addEventListener('touchend', endTouch, { passive: true });
      hero.addEventListener('touchcancel', endTouch, { passive: true });

      // One-off sweep on touch screens, if the lettering is on screen and untouched.
      if (!finePointer.matches) {
        setTimeout(() => {
          const r = hero.getBoundingClientRect();
          if (touched || r.bottom <= 0 || r.top >= innerHeight) return;
          const W = img.naturalWidth, H = img.naturalHeight;
          let prev = null, t0 = null;
          const step = (now) => {
            if (touched) return;
            t0 ??= now;
            const t = Math.min(1, (now - t0) / INTRO_MS);
            const e = t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2;   // ease in-out
            const p = { x: W * (0.04 + 0.92 * e), y: H * (0.6 + Math.sin(e * Math.PI * 3) * 0.14) };
            if (prev) push(prev, p);
            prev = p;
            if (t < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        }, 500);
      }
      new ResizeObserver(() => { setup(); }).observe(hero);
      reduceMotion.addEventListener('change', (e) => {
        if (!e.matches) return;
        canvas.remove(); hero.classList.remove('fx-on');
      });
    }

    if (img.complete && img.naturalWidth) init();
    else img.addEventListener('load', init, { once: true });
  })();
  </script>
</Base>
