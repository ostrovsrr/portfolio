---
// Shared page shell: <head>, header and footer. Every page wraps its content in this.
import '../styles/global.css';

// Draft mode (drag, edit and annotate the page locally) exists only in `npm run dev`,
// or in a build made with PUBLIC_DRAFT_MODE=true. Normal builds never include it.
const draftMode = import.meta.env.DEV || import.meta.env.PUBLIC_DRAFT_MODE === 'true';
const DevEditor = draftMode ? (await import('../dev-editor/DevEditor.astro')).default : undefined;

type NavKey = 'home' | 'projects' | 'events' | 'contacts';

interface Props {
  title: string;
  description: string;
  active?: NavKey;
  ogTitle?: string;
  ogDescription?: string;
  /** Desktop only: lay the header over the hero lettering (home page). */
  overlayHeader?: boolean;
  /** 'big': the home page's large contact block. 'minimal': links and copyright only. */
  footer?: 'big' | 'default' | 'minimal';
}
const {
  title,
  description,
  active,
  ogTitle = title,
  ogDescription = description,
  overlayHeader = false,
  footer = 'default',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = active === 'home';
const path = Astro.url.pathname.replace(/\.html$/, '');

const nav: { key?: NavKey; label: string; href: string }[] = [
  { key: 'projects', label: 'work', href: '/projects' },
  { key: 'events', label: 'events', href: '/events' },
  { label: 'about', href: isHome ? '#about' : '/#about' },
  { key: 'contacts', label: 'contact', href: '/contacts' },
];
// "page" on the page itself; "true" on pages inside that section (case studies under work).
const current = (item: { key?: NavKey; href: string }) =>
  item.key && item.key === active ? (path === item.href ? 'page' : 'true') : undefined;

const social = [
  { label: 'github', href: 'https://github.com/ostrovsrr' },
  { label: 'linkedin', href: 'https://www.linkedin.com/in/rodion-ostrovskii/' },
];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta property="og:title" content={ogTitle}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <!-- Add a 1200x630 image to public/img/og.png, then: <meta property="og:image" content="https://rodion-ostrovskii.com/img/og.png"> -->
  <meta name="theme-color" content="#eaeaea">
  <link rel="icon" href="data:,">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>

<header class:list={['top', { 'top--overlay': overlayHeader }]}>
  <a href="/" class="top__name" aria-current={isHome ? 'page' : undefined}>rodion</a>
  <span class="top__role">software engineer</span>
  <nav class="top__nav" aria-label="Main">
    <ul class="top__list">
      {nav.map((item) => <li><a href={item.href} aria-current={current(item)}>{item.label}</a></li>)}
    </ul>
  </nav>
  <ul class="top__list top__social">
    {social.map((s) => <li><a href={s.href} target="_blank" rel="noreferrer">{s.label}</a></li>)}
  </ul>
  <span class="top__place">oakville, on</span>
</header>

<slot />

<footer
  class:list={['section', 'contact', { 'contact--big': footer === 'big', 'contact--minimal': footer === 'minimal' }]}
  id={footer === 'big' ? 'contact' : undefined}
>
  {footer !== 'minimal' && <p class="label">(contact)</p>}
  {footer !== 'minimal' && <a class="contact__mail" href="mailto:ostrovsrr@gmail.com">ostrovsrr@gmail.com</a>}
  <div class="contact__row">
    <ul>
      {social.map((s) => <li><a href={s.href} target="_blank" rel="noreferrer">{s.label}</a></li>)}
    </ul>
    <span class="muted">oakville, ontario · © {year} rodion ostrovskii</span>
  </div>
</footer>

{DevEditor && <DevEditor />}
</body>
</html>
