---
// Illustration of the QA platform's results view. Sample numbers only:
// never put real client data here. `compact` shortens labels for small covers;
// `large` is the case-study size.
interface Props {
  compact?: boolean;
  large?: boolean;
}
const { compact = false, large = false } = Astro.props;
---
<div class:list={['mock', { 'mock--large': large }]} aria-hidden="true">
  <div class="mock-panel">
    <div class="mock-head"><span>{compact ? 'Import results · 3 stores' : 'Import results · 3 test stores'}</span><span class="ok">96.8%</span></div>
    <div class="mock-row"><span>Imported</span><span></span><span class="ok">11,842</span></div>
    <div class="mock-row"><span>{compact ? 'Blank option' : 'Blank option value'}</span><code>BLANK</code><span class="no">214</span></div>
    <div class="mock-row"><span>Duplicate variant</span><code>TAKEN</code><span class="no">97</span></div>
    <div class="mock-row"><span>Invalid email</span><code>INVALID</code><span class="no">41</span></div>
  </div>
</div>

<style>
  .mock {
    width: 100%; aspect-ratio: 4 / 3; background: #dcdcdc; border: 1px solid var(--line);
    display: flex; align-items: center; justify-content: center; padding: 18px;
  }
  .mock--large { aspect-ratio: 2 / 1; padding: 32px; }
  .mock-panel {
    width: 100%; max-width: 360px; background: #f4f4f4; border: 1px solid var(--line);
    padding: 12px 14px; font-size: 12px; line-height: 1.35; text-align: left; color: var(--ink);
  }
  .mock--large .mock-panel { max-width: 560px; font-size: 16px; padding: 20px 24px; }
  .mock-head { display: flex; justify-content: space-between; gap: 12px; font-weight: 600; margin-bottom: 8px; }
  .mock-row { display: grid; grid-template-columns: 1fr auto 44px; gap: 10px; padding: 6px 0; border-top: 1px solid var(--line); }
  .mock--large .mock-row { grid-template-columns: 1fr auto 64px; padding: 10px 0; }
  .mock-row code { font-family: ui-monospace, Consolas, monospace; font-size: 11px; color: var(--muted); }
  .mock--large .mock-row code { font-size: 13px; }
  .mock-row span:last-child { text-align: right; }
  .ok { font-weight: 600; }
  .no { font-weight: 600; color: var(--muted); }
  @media (max-width: 860px) {
    .mock--large { aspect-ratio: auto; padding: 24px; }
  }
  @media (max-width: 480px) {
    .mock--large { padding: 16px; }
    .mock--large .mock-panel { font-size: 13px; padding: 12px 14px; }
    .mock--large .mock-row { grid-template-columns: 1fr auto 48px; padding: 7px 0; }
    .mock--large .mock-row code { font-size: 11px; }
  }
</style>
