---
import type { Project } from '../data/projects';
import QaMock from './QaMock.astro';
import CoverArt from './CoverArt.astro';

interface Props {
  project: Project;
  headingLevel?: 'h2' | 'h3';
}
const { project, headingLevel: Heading = 'h3' } = Astro.props;
const { title, description, href, external, cover, tags, stats } = project;
---
<a class="project" href={href} {...(external ? { target: '_blank', rel: 'noreferrer' } : {})}>
  {cover.kind === 'qa-mock' && <QaMock compact />}
  {cover.kind === 'art' && <CoverArt title={cover.title} subtitle={cover.subtitle} warm={cover.warm} />}
  {cover.kind === 'image' && <img src={cover.src} alt="" class="project__img" loading="lazy" />}
  <Heading class="project__title">{title}</Heading>
  <p class="project__desc">{description}</p>
  {stats && (
    <div class="project__stats">
      {stats.map((s) => <div><b>{s.value}</b><span>{s.label}</span></div>)}
    </div>
  )}
  <ul class="tags">{tags.map((t) => <li>{t}</li>)}</ul>
  {!external && <span class="project__more">Read case study →</span>}
</a>
